/*
  # Security headers
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Cache HTML: revalidate every time (content changes daily)
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Cloudflare Pages serves files at literal paths (no content hashing),
# so JS/CSS must not be cached immutably — they change on every deploy.
/css/*
  Cache-Control: public, max-age=3600

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# SEO / crawler files: short cache so updates propagate quickly
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
